# Envoi des emails du formulaire "Témoigner" (voir lib/mailer.ts)
# Créez un compte sur https://resend.com, ajoutez/vérifiez un domaine d'envoi,
# puis générez une clé API.
RESEND_API_KEY=

# Adresse "From" utilisée pour les envois. Doit provenir d'un domaine vérifié
# sur Resend (ex: "SPLASH <contact@splash-media.fr>"). En développement, vous
# pouvez utiliser l'adresse de test Resend : "SPLASH <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

# Adresse de l'équipe SPLASH qui reçoit les soumissions du formulaire.
CONTACT_EMAIL=
